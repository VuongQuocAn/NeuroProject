# Backend database
# Local PowerShell run outside Docker can use localhost instead of db.
DATABASE_URL=postgresql://admin:password123@localhost:5432/neuro_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object storage. For local Docker use localhost:9000 and MINIO_SECURE=false.
# For Cloudflare R2 use: <account_id>.r2.cloudflarestorage.com and MINIO_SECURE=true.
MINIO_URL=localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_SECURE=false
MINIO_REGION=us-east-1

# Frontend/CORS. In production set these to your Vercel URL.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT signing key. Use a long random value in production.
SECRET_KEY=change_me_to_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini for Agent/Chatbox, XAI explanation and reports
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Hugging Face API token for query embedding.
# Required: backend uses HF Inference API for BAAI/bge-m3 query vectors.
HF_API_TOKEN=
# Leave empty to use:
# https://router.huggingface.co/hf-inference/models/BAAI/bge-m3/pipeline/feature-extraction
HF_EMBEDDING_API_URL=https://router.huggingface.co/hf-inference/models/BAAI/bge-m3/pipeline/feature-extraction

# Rerank top dense child chunks before sending top 3 contexts to Gemini.
HF_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HF_RERANKER_API_URL=https://router.huggingface.co/hf-inference/models/BAAI/bge-reranker-v2-m3

# Frontend (Vercel)
NEXT_PUBLIC_API_URL=http://localhost:8001

# docker-compose.local.yml overrides database/storage hosts for containers.
# These credentials are for development on your own machine.
POSTGRES_DB=neuro_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123

# Seed demo NeuroBoard users/posts on a new local database.
# Set false before startup if you want to create only your own board content.
NEUROBOARD_SEED_DEMO=true
ALLOW_VERCEL_PREVIEWS=true

# Only docker-compose.local.yml enables the bundled patient seed by default.
# It creates missing UCSF-003/UCSF-001 once, without replacing existing records.
# LOCAL_DEMO_SEED=false
# Local API uses 8001 so the Vercel/tunnel backend can keep using 8000.
LOCAL_BACKEND_PORT=8001
